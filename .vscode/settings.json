	"workbench.colorCustomizations": {
		"activityBar.activeBackground": "#660000",
		"activityBar.background": "#660000",
		"activityBar.foreground": "#e7e7e7",
		"activityBar.inactiveForeground": "#e7e7e799",
		"activityBarBadge.background": "#008000",
		"activityBarBadge.foreground": "#e7e7e7",
		"commandCenter.border": "#e7e7e799",
		"sash.hoverBorder": "#660000",
		"statusBarItem.hoverBackground": "#660000",
		"statusBarItem.remoteBackground": "#330000",
		"statusBarItem.remoteForeground": "#e7e7e7",
		"titleBar.activeBackground": "#330000",
		"titleBar.activeForeground": "#e7e7e7",
		"titleBar.inactiveBackground": "#33000099",
		"titleBar.inactiveForeground": "#e7e7e799",
		"statusBar.background": "#330000",
		"statusBar.foreground": "#e7e7e7"
	},
	"peacock.color": "#330000",
	"workbench.editor.customLabels.enabled": true,
	"workbench.editor.customLabels.patterns": {
		"*/src/errors/**": "ERR ${filename}",
		"*/src/files/**": "F: ${filename}",
		"*/src/files/savegame/**": "F:SAVE ${filename}",
		"*/src/files/store_item/**": "F:STORE ${filename}",
		"*/src/savegame/**": "SAVE ${filename}",
		"*/tests/**": "TEST ${filename}"
	},
	"cSpell.ignorePaths": [
		"package-lock.json",
		"node_modules",
		"vscode-extension",
		".git/{info,lfs,logs,refs,objects}/**",
		".git/{index,*refs,*HEAD}",
		".vscode",
		".vscode-insiders",
		"tests/test_mods/**",
		"tests/test_mod_json/*",
		"Cargo*"
	],
	"cSpell.spellCheckOnlyWorkspaceFiles": true,
}