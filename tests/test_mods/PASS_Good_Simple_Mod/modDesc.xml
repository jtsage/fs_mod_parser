    <version>1.0.0.0</version>

    <extraSourceFiles>
        <sourceFile filename="scripts/main.lua" />
        <sourceFile filename="scripts/sub_1.lua" />
        <sourceFile filename="scripts/sub_2.lua" />
    </extraSourceFiles>

    <iconFilename>modIcon.dds</iconFilename>
    <multiplayer supported="true" />

    <dependencies>
        <dependency>FS22_RedBarnPack</dependency>
    </dependencies>

    <storeItems>
        <storeItem xmlFilename="Dolly.xml" />
    </storeItems>

    <l10n filenamePrefix="languages/l10n" />

    <l10n>
        <text name="config_5WSemiLocking">
            <en>Partial locking</en>
            <de>Teilverriegelung</de>
        </text>
        <text name="config_5WHardLocking">
            <fr>Verrouillage dur</fr>
            <de>Harte Verriegelung</de>
        </text>
    </l10n>

    <brandColors>
        <color name="MANTRID_RED1" value="0.2866 0.0025 0.0025 1" />
        <color name="MANTRID_RED2" value="0.5732 0.0050 0.0050 1" />
        <color name="MANTRID_GREEN1" value="0.0300 0.1569 0.0110 1" />
        <color name="MANTRID_GREEN2" value="0.0600 0.2801 0.0254 1" />
    </brandColors>

    <vehicleSchemaOverlays filename="textures/vehicleSchemaMantrid.dds" imageSize="256 256">
        <overlay name="DOLLY" uvs="28px 0px 64px 64px" size="60px 30px" />
        <overlay name="DOLLY_SELECTED" uvs="28px 65px 64px 64px" size="60px 30px" />
    </vehicleSchemaOverlays>

    <actions>
        <action name="aim_menu" category="SYSTEM" axisType="HALF" ignoreComboMask="false" />
        <action name="aim_hot1" category="SYSTEM" axisType="HALF" ignoreComboMask="false" />
        <action name="aim_togg" axisType="HALF" ignoreComboMask="false" />
    </actions>
    <inputBinding>
        <actionBinding action="aim_menu">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lshift KEY_slash" />
            <binding device="KB_MOUSE_DEFAULT" input="MOUSE_BUTTON_X1" axisComponent="+"
                neutralInput="0" index="3" />
        </actionBinding>
        <actionBinding action="aim_hot1">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_ralt KEY_KP_1" />
        </actionBinding>
        <actionBinding action="aim_togg">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_ralt KEY_KP_0" />
        </actionBinding>
    </inputBinding>

    <maps>
        <map id="BackRoadsCounty" className="Mission00" filename="$dataS/scripts/missions/mission00.lua" configFilename="map/xml/map.xml"
            defaultVehiclesXMLFilename="map/xml/vehicles.xml"
            defaultPlaceablesXMLFilename="map/xml/placeables.xml"
            defaultItemsXMLFilename="map/xml/items.xml">
            <title>
                <en>Back Roads County 4x</en>
            </title>
            <description>
                <en>Welcome To Back Roads County 4x.</en>
                <de>Willkommen in Back Roads County 4x.</de>
            </description>

            <iconFilename>preview.dds</iconFilename>
        </map>
    </maps>

</modDesc>